{
  "name": "arg-merchant-quest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "description": "Real-world ARG advertising platform for local merchants (Solana Devnet demo)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/reset-db.mjs",
    "chain:build": "cd programs/completion-counter && cargo build-sbf --sbf-out-dir ../../.data/chain",
    "chain:setup": "node scripts/chain/setup.mjs",
    "chain:state": "node scripts/chain/state.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@magicblock-labs/ephemeral-rollups-sdk": "^0.20.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3"
  }
}
