# Prototype only. Devnet and valueless test tokens — no real money.
APP_ENV=development
DEMO_ONLY=true
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana Devnet RPC used for the base layer. The public endpoint throttles
# program deploys; MagicBlock's devnet RPC is friendlier for chain scripts.
ARG_SOLANA_RPC_URL=https://api.devnet.solana.com

# MagicBlock Ephemeral Rollup used for the campaign completion counter.
ARG_MAGICBLOCK_ER_RPC_URL=https://devnet-us.magicblock.app
ARG_MAGICBLOCK_ER_VALIDATOR=MUS3hc9TCw4cGC12vHNoYcCGzJG1txjgQLZWVoeNHNd
ARG_MAGIC_ROUTER_URL=https://devnet-router.magicblock.app

# Paths created by `npm run chain:setup`; all live under the gitignored .data/.
# ARG_TREASURY_KEYPAIR=.data/wallets/treasury.json
# ARG_REWARD_MINT=            # defaults to .data/chain/mint.json (tUSDC demo token)
# ARG_COUNTER_PROGRAM_ID=     # defaults to .data/chain/program.json

# Test asset mint is NOT automatically real Circle USDC. When this flag is on
# (default) the app prefers Circle's devnet USDC if the treasury holds it, and
# otherwise pays the labelled ARG demo test token.
ARG_PREFER_CIRCLE_USDC=true
REWARD_KRW_EQUIVALENT=100
