# Prototype only. Devnet and valueless test tokens — no real money.
APP_ENV=development

# Production/demo deployment (one instance, see docs/DEPLOYMENT.md):
# point ARG_DATA_DIR at a persistent volume so the SQLite database survives
# restarts and redeploys. Do not bake .data/ into an image and do not run two
# instances against the same file. PORT/HOSTNAME are read by `next start`.
# APP_ENV=production
# ARG_DATA_DIR=/var/lib/arg-merchant-quest
# ARG_DB_PATH=/var/lib/arg-merchant-quest/arg.db
DEMO_ONLY=true
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana Devnet RPC used for the base layer. The public endpoint throttles
# program deploys; MagicBlock's devnet RPC is friendlier for chain scripts.
ARG_SOLANA_RPC_URL=https://api.devnet.solana.com

# MagicBlock Ephemeral Rollup used for the campaign completion counter.
# The router may delegate to devnet-as / devnet-us / devnet-eu, so the app
# records and verifies against the endpoint the router actually chose rather
# than assuming this example region.
ARG_MAGICBLOCK_ER_RPC_URL=https://devnet-us.magicblock.app
ARG_MAGICBLOCK_ER_VALIDATOR=MUS3hc9TCw4cGC12vHNoYcCGzJG1txjgQLZWVoeNHNd
ARG_MAGIC_ROUTER_URL=https://devnet-router.magicblock.app

# Paths created by `npm run chain:setup`; all live under the gitignored .data/.
# Payouts and the MagicBlock counter are optional: without these the app says
# they are unconfigured instead of pretending. A demo coupon still works.
#
# Treasury backup/restore: keep the keypair file in your own secret store, then
# point ARG_TREASURY_KEYPAIR at the restored copy. Never commit the key or
# regenerate the treasury just because a local file is missing.
# ARG_TREASURY_KEYPAIR=/secure/path/treasury.json
# ARG_REWARD_MINT=61xJEucfUnrnf5aUotkmCGuUE41X28WiEn9K6M2YueS1   # defaults to .data/chain/mint.json
# ARG_COUNTER_PROGRAM_ID=8q2dWZ81rkxShwUJThe48zuSL3ZURwhDwSzFcqqhPh3C   # defaults to .data/chain/program.json

# Test asset mint is NOT automatically real Circle USDC. When this flag is on
# (default) the app prefers Circle's devnet USDC if the treasury holds it, and
# otherwise pays the labelled ARG demo test token.
ARG_PREFER_CIRCLE_USDC=true
REWARD_KRW_EQUIVALENT=100

# Optional AI companion + merchant story lab.
# Default provider: the official Claude API through its OpenAI-compatible
# endpoint. Any other OpenAI-compatible server works by setting
# ARG_AI_BASE_URL. Without a key the app uses a deterministic, clearly labelled
# scripted guide and local draft concepts. Keep the key server-side; never
# commit it or expose it to the browser.
# ARG_AI_BASE_URL=https://api.anthropic.com/v1
# ARG_AI_MODEL=claude-opus-5-5
# ARG_AI_API_KEY=
#
# Claude 4.7 and later reject temperature/top_p below 1, so the client omits
# them for those models. Set ARG_AI_VERSION only to pin an older API version,
# and ARG_AI_WORKSPACE_ID only when the key is not scoped to one workspace.
# ARG_AI_VERSION=2023-06-01
# ARG_AI_WORKSPACE_ID=

# P3: optional token-funded "deep investigation" for Mara (Solana Devnet only).
# The player pays with the existing visit token; the model call is the app's
# real Claude request. The trail, hints, reward and free companion never need
# this. The receiver is a public address (defaults to the treasury public key).
# ARG_AI_PAYMENTS_ENABLED=true
# ARG_AI_PAYMENT_PRICE=200000
# ARG_AI_PAYMENT_RECEIVER=
# ARG_AI_INTENT_TTL_SECONDS=900
# ARG_AI_MAX_PENDING_INTENTS=3
# ARG_AI_MAX_PER_DAY=5
# ARG_AI_DAILY_USD_LIMIT=1
# ARG_AI_MAX_OUTPUT_TOKENS=1600
# ARG_AI_INPUT_COST_PER_M=4
# ARG_AI_OUTPUT_COST_PER_M=20
